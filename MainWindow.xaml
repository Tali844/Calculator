<Window x:Class="Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="LightGreen">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Source="/Images/calc.png" />
        <Image Source="/Images/calc.png" Grid.Column="2"/>

        <TextBlock Text="מחשבון" FontSize="40" Foreground="CadetBlue"  FontWeight="ExtraBold" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox Width="70" Height="30" Grid.Row="1" Grid.Column="0" x:Name="num1"/>
        <TextBox Width="70" Height="30" Grid.Row="2" Grid.Column="0" x:Name="num2"/>

        <Button Content="+" Grid.Row="1" Grid.Column="2"
                Width="40" Height="40" Click="Plus"/>
        <Button Content="-" Grid.Row="2" Grid.Column="2" Width="40" Height="40" Click="Minus"/>
        <Button Content="*" Grid.Row="3" Grid.Column="2" Width="40" Height="40" Click="Mult"/>
        <Button Content="/" Grid.Row="4" Grid.Column="2" Width="40" Height="40" Click="Div"/>
        <TextBlock Text=" :התשובה היא " FontSize="30"  Grid.Row="3" Grid.Column="0" 
                   Grid.ColumnSpan="2" 
                   HorizontalAlignment="Center"
                   Visibility="Collapsed"
                   x:Name="answer"/>




    </Grid>
</Window>
